  m_Name: 
  m_EditorClassIdentifier: AlmaDino.Features.Environment::AlmaDino.Features.Environment.NarrativePrologueTrigger
  _title: DESPERTAR EN EL NIDO
  _message: "La tierra tembl\xF3 una sola vez.\nCuando regres\xE9 al nido con comida, el silencio era absoluto. No estaban.\nSi tengo que cruzar el continente entero a pie, mis peque\xF1os volver\xE1n a sentir el calor de mis plumas."
  _bannerColor: {r: 0.95, g: 0.75, b: 0.2, a: 1}
  _displayDuration: 6.5
