  m_GameObject: {fileID: 330585543}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d4000000000000000000000000000006, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _showPrologueOnStart: 1
  _prologueText: "La tierra tembl\xF3 una sola vez.\nCuando regres\xE9 al nido con comida, el silencio era absoluto. No estaban.\nSi tengo que cruzar el continente entero a pie,\nmis peque\xF1os volver\xE1n a sentir el calor de mis plumas."
